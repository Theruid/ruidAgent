{
  "name": "@theruid/ruid",
  "version": "0.3.30",
  "description": "Standalone CLI coding agent — works with any LLM provider",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ruid": "dist/index.js",
    "theruid": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Theruid/ruidAgent.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.15.9",
    "ink": "^6.8.0",
    "react": "^19.2.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.18",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "license": "Apache-2.0"
}
